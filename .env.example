# ==============================================================================
# AgriSense Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your local values.
# NEVER commit your actual '.env' file containing credentials to Git.
# ==============================================================================

# Google Earth Engine Configuration
# Specify the Google Cloud Project ID configured with Earth Engine API enabled
GEE_PROJECT_ID=your-gcp-project-id-here

# Optional: Path to Google Service Account Key (if not using interactive 'earthengine authenticate')
GEE_SERVICE_ACCOUNT_KEY_PATH=

# Application & Caching Settings
AGRISENSE_ENV=development
AGRISENSE_LOG_LEVEL=INFO
AGRISENSE_CACHE_DIR=./data/cache
AGRISENSE_OUTPUT_DIR=./data/outputs

# Streamlit Configuration (Optional overrides)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
